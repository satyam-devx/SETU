# ═══════════════════════════════════════════════════════════════
# SETU — HTTP security headers
#
# Honoured by Cloudflare Pages and Netlify (Vite copies public/ → dist
# root, so this ships as dist/_headers). GitHub Pages IGNORES this file
# — which is exactly why the audit recommends moving off Pages: a
# fintech SPA storing Supabase JWTs in localStorage has no defence-in-
# depth against XSS without a Content-Security-Policy, and Pages cannot
# set one.
#
# ⚠️  VALIDATE IN STAGING BEFORE ENFORCING IN PRODUCTION.
# The CSP below allow-lists every external origin the app currently
# talks to (Supabase, Razorpay, Firebase/FCM, Mapbox, Leaflet/unpkg).
# If you add a new third-party origin, add it here or the browser will
# block it. To roll out safely, first ship it as
# "Content-Security-Policy-Report-Only" (rename the header), watch the
# violation reports, then switch to enforcing.
#
# Origins in use (grep-verified against src/ + public/):
#   Supabase     : https://*.supabase.co  (REST + Realtime wss)
#   Razorpay     : checkout.razorpay.com (script), api/*.razorpay.com (xhr/iframe)
#   Firebase FCM : www.gstatic.com (SW SDK), *.googleapis.com / fcm.googleapis.com
#   Mapbox       : api.mapbox.com, *.tiles.mapbox.com, events.mapbox.com
#   Leaflet      : unpkg.com (script/css/marker imgs), *.tile.openstreetmap.org
# ═══════════════════════════════════════════════════════════════

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://checkout.razorpay.com https://unpkg.com https://api.mapbox.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://unpkg.com https://api.mapbox.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.razorpay.com https://lumberjack.razorpay.com https://*.googleapis.com https://fcm.googleapis.com https://api.mapbox.com https://events.mapbox.com https://*.tiles.mapbox.com https://*.tile.openstreetmap.org https://unpkg.com; frame-src 'self' https://api.razorpay.com https://*.razorpay.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(), payment=(self)
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Long-cache fingerprinted build assets (Vite hashes filenames).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Never cache the service worker — must update promptly.
/firebase-messaging-sw.js
  Cache-Control: no-cache
