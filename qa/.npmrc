# SETU — npm config
#
# legacy-peer-deps=true: several dependencies (lucide-react@0.383.0, etc.)
# still declare a React 18 peer range even though this project runs React
# 19 in practice. Without this, `npm install`/`npm ci` either hard-fails
# (strict peer resolution) or spams ERESOLVE warnings on every install,
# both locally and in CI. This makes that consistent everywhere instead of
# depending on each CI workflow remembering an env var — see CHANGELOG.md.
#
# When bumping a peer-conflicted package to a version with real React 19
# support, feel free to remove it from the conflict set — this flag isn't
# meant to mask every future conflict forever, just the current known ones.
legacy-peer-deps=true
