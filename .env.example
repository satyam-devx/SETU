# Anthropic (Claude Haiku via proxy)
VITE_ANTHROPIC_PROXY_URL=https://your-proxy.com/api/claude

# App config
VITE_PLATFORM_NAME=SETU
VITE_DISTRICT=Madhubani
VITE_DEFAULT_BLOCK=Madhepur

# ─────────────────────────────────────────────────
# SETU Platform — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────

# Supabase project URL (from Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (from Project Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────
# FUTURE PHASES (add as you implement)
# ─────────────────────────────────────────────────

# Phase 3 — Payments
# VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Phase 4 — Maps
# VITE_MAPBOX_TOKEN=pk.your_mapbox_token

