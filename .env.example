# ═══════════════════════════════════════════════════════════
# SETU Platform — Environment Variables
# ═══════════════════════════════════════════════════════════
#
# USAGE:
#   cp .env.example .env.local
#   Fill in the real values for local development.
#
# NEVER commit .env.local or any file with real secrets.
# GitHub Actions reads secrets from GitHub Secrets (Settings → Secrets).
#
# ─────────────────────────────────────────────────────────
# HOW TO GET THESE VALUES:
#
# Supabase → https://app.supabase.com → Your Project → Settings → API
# Firebase → https://console.firebase.google.com → Project Settings
# Razorpay → https://dashboard.razorpay.com → Settings → API Keys
# SurePass  → https://dashboard.surepass.io → API Keys
# ─────────────────────────────────────────────────────────

# ── Supabase (Frontend) ───────────────────────────────────
# Found at: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Found at: Supabase Dashboard → Settings → API → anon public
# This key is safe to expose in the browser — it's public.
# RLS policies protect your data, not this key.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder

# VITE_DEMO_MODE — leave unset/false for real deployments.
# Only set to "true" for local previews or CI/QA test runs that
# intentionally run WITHOUT real Supabase credentials. If
# VITE_SUPABASE_URL/ANON_KEY are missing AND this is not "true", the
# app shows a configuration-error screen instead of starting — see
# CRITICAL-5 in SECURITY_FIXES.md for why.
VITE_DEMO_MODE=false

# ── Firebase (FCM Push Notifications) ────────────────────
# Found at: Firebase Console → Project Settings → General → Your apps → SDK setup
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderReplaceMeWithRealValue
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:placeholder00000000000000

# Found at: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=BPlaceholder_ReplaceMeWithRealVAPIDKeyFromFirebaseConsole

# ─────────────────────────────────────────────────────────
# ── Mapbox (location/map features) ───────────────────────
# Found at: https://account.mapbox.com → Access tokens
VITE_MAPBOX_TOKEN=pk.eyJ1IjoicGxhY2Vob2xkZXIiLCJhIjoiY2xwbGFjZWhvbGRlciJ9.placeholder

# ── Razorpay (frontend key — safe to expose in browser) ──
# Found at: Razorpay Dashboard → Settings → API Keys → Key ID only (not secret)
# NOTE: The secret key (RAZORPAY_KEY_SECRET) must NEVER go here — backend/CI only
VITE_RAZORPAY_KEY_ID=rzp_live_placeholder

# The following are GitHub Actions secrets (NOT Vite env vars).
# They are NOT prefixed with VITE_ and are never exposed to the browser.
# Add them at: GitHub → Your Repo → Settings → Secrets and Variables → Actions
# ─────────────────────────────────────────────────────────

# SUPABASE_ACCESS_TOKEN       — Supabase CLI auth (Dashboard → Account → Access Tokens)
# SUPABASE_PROJECT_REF        — Your project ref (e.g. abcdefghijklmnop) — from project URL
# SUPABASE_DB_PASSWORD        — Database password (set when you created the project)
# SUPABASE_DB_URL             — postgres://postgres:[password]@db.[ref].supabase.co:5432/postgres
# SUPABASE_SERVICE_ROLE_KEY   — Service role key (NEVER use in frontend — backend/CI only)
#
# RAZORPAY_KEY_ID             — Razorpay key ID (rzp_live_... or rzp_test_...)
# RAZORPAY_KEY_SECRET         — Razorpay secret key
# RAZORPAY_WEBHOOK_SECRET     — Webhook verification secret (set in Razorpay dashboard)
#
# FIREBASE_SERVICE_ACCOUNT_JSON — Full service account JSON for FCM (from Firebase Console
#                                  → Project Settings → Service accounts → Generate new key)
#
# SUREPASS_API_KEY            — SurePass Aadhaar verification API key
# ANTHROPIC_API_KEY           — Anthropic API key (for Phase 5 AI assistant)
#
# ALLOWED_ORIGINS              — Edge Function CORS allow-list (comma-separated),
#                                 e.g. "https://your-project.pages.dev,https://setu.app"
#                                 Set this as an Edge Function secret
#                                 (Supabase Dashboard → Edge Functions → Secrets), NOT
#                                 a GitHub secret. Defaults to localhost-only if unset.
# ALLOW_KYC_DEV_BYPASS          — Edge Function secret. Leave unset/"false" in
#                                 production. Only set to "true" in a dev/staging
#                                 Supabase project that intentionally has no
#                                 SUREPASS_API_KEY configured, to let KYC testing
#                                 proceed with a fake OTP. NEVER set this in prod.
#
# PROD_URL                    — GitHub Repository Variable (not secret):
#                               e.g. https://yourusername.github.io/SETU
#                               Set at: Settings → Variables → Actions
