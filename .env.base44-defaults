# ─────────────────────────────────────────────────────────
# Base44 local-preview defaults (placeholders).
# These get the SETU frontend booting in DEMO mode with NO real
# backend. Real secrets (when provided) are delivered via the
# platform-managed /run/base44/app.env, which is listed AFTER
# this file in docker-compose.base44.yml and therefore wins.
# ─────────────────────────────────────────────────────────

# Run without a real Supabase backend — see src/lib/supabase.js.
VITE_DEMO_MODE=true

# Placeholders so VITE_* reads are non-empty; demo mode ignores them.
VITE_SUPABASE_URL=https://placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=placeholder-anon-key

# Optional integrations — left blank; only needed for real deployments.
VITE_SUPABASE_REPLICA_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_MAPBOX_TOKEN=
VITE_RAZORPAY_KEY_ID=
